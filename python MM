    def run_logic(self):
        for i in self.tree.get_children():
            self.tree.delete(i)

        pending_patients = self.patients.copy()
        # Track when each specific resource instance will become free
        resource_busy_until = {
            'Doctor': [0] * self.resource_counts['Doctor'],
            'Room': [0] * self.resource_counts['Room'],
            'Equipment': [0] * self.resource_counts['Equipment']
        }
        
        usage_time = {'Doctor': 0, 'Room': 0, 'Equipment': 0}
        schedule = []
        treatment_duration = 20
        sim_end_time = 200 # Extended to allow all to be treated
        
        for current_time in range(0, sim_end_time + 1, 5):
            # 1. Filter patients who have arrived and are not yet treated
            available_now = [p for p in pending_patients if p['arrival'] <= current_time]
            
            # 2. Sort by Urgency (Descending) then Arrival (Ascending)
            available_now.sort(key=lambda x: (-x['urgency'], x['arrival']))

            for p in available_now:
                res_type = p['type']
                # Check if any resource of this type is free
                # A resource is free if its 'busy_until' time <= current_time
                free_resources = [i for i, free_at in enumerate(resource_busy_until[res_type]) if free_at <= current_time]
                
                if free_resources:
                    target_idx = free_resources[0]
                    start_time = current_time
                    end_time = current_time + treatment_duration
                    
                    # Mark resource as busy
                    resource_busy_until[res_type][target_idx] = end_time
                    usage_time[res_type] += treatment_duration
                    
                    schedule.append((p['name'], res_type, start_time, end_time))
                    pending_patients.remove(p)

        # Update Table
        for entry in schedule:
            self.tree.insert("", "end", values=entry)

        # Update Stats
        stats_text = "Resource Utilisation:\n"
        total_sim_time = sim_end_time
        for k, v in usage_time.items():
            max_capacity = self.resource_counts[k] * total_sim_time
            util = (v / max_capacity) * 100 if max_capacity > 0 else 0
            stats_text += f" - {k}: {min(util, 100.0):.1f}%\n"
        
        stats_text += f"\nUntreated: {len(pending_patients)}"
        self.stats_label.config(text=stats_text)
        messagebox.showinfo("Success", "Simulation Completed with Fixed Logic!")

